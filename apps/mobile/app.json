{
  "expo": {
    "name": "Afilmory",
    "slug": "afilmory",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "afilmory",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "app.afilmory",
      "buildNumber": "1",
      "appleTeamId": "KAMM5N88X3",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        },
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["en", "zh-Hans", "zh-HK", "zh-TW", "ja", "ko"],
        "LSApplicationCategoryType": "public.app-category.photography",
        "NSPhotoLibraryUsageDescription": "Allow Afilmory Studio to select photos for your gallery.",
        "NSSupportsLiveActivities": true,
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "app.afilmory",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "@bacons/apple-targets",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
